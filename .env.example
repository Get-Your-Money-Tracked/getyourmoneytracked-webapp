# Required for the app to function
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Backend API URL (used by Vite dev proxy for /graphql)
# VITE_API_URL=http://localhost:8080

# Optional: override the GraphQL API URL (defaults to /graphql which proxies via VITE_API_URL in dev)
# In production (Netlify), set VITE_GRAPHQL_URL to point to your Fly.io backend:
# VITE_GRAPHQL_URL=https://getyourmoneytracked-api.fly.dev/graphql
